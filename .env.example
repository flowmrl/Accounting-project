# ── Base de données ──────────────────────────────────────────────────────────
# En local (docker compose) :
DATABASE_URL=postgresql+psycopg2://compta:compta@postgres:5432/compta_pme
# En production, remplacer par l'URL fournie par Railway / Supabase / RDS :
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

DB_ECHO=false

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 heures

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=Compta PME
VERSION=1.0.0
